{
  "name": "trowa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/urbanist": "^5.3.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "jspdf": "^4.2.1",
    "opensheetmusicdisplay": "^2.2.1",
    "svg2pdf.js": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@xmldom/xmldom": "^0.9.12",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "undici": "^7.30.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@spotify/basic-pitch": {
      "@tensorflow/tfjs": "$@tensorflow/tfjs"
    }
  }
}
